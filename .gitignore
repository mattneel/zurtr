# Zig build artifacts: regenerated by any build, never committed. Unrooted, so these
# cover every vendored dependency's own build output as well as this tree's.
.zig-cache/
zig-cache/
zig-out/
zig-pkg/

# Editors / tooling
.vscode/
.idea/
*.swp

# OS noise
.DS_Store
Thumbs.db

# mdBook's build output
book/

# The client library's toolchain
client/node_modules/
